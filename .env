# App
APP_NAME=Image Composer MVP
ENV=development

# Backend
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3100,http://localhost:8088

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:8088
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=image-composer
MINIO_SECURE=false


# JWT Auth
JWT_PRIVATE_KEY_PATH=/app/private.pem
JWT_PUBLIC_KEY_PATH=/app/public.pem
JWT_ALGORITHM=RS256
JWT_EXPIRE_MINUTES=1440

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/image_composer

# Default Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123456
